#!/bin/bash

################################################################################
# Mock CSPOT Script - Emulates senspot-get for testing
# 
# This script loads data from local text files instead of connecting to CSPOT
# Usage: senspot-get -W woof://<path>
################################################################################

# Default mock data directory
MOCK_DATA_DIR="mimi_cspot"

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -W)
            WOOF_URL="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Extract path from woof URL (e.g., woof://169.231.230.76/sharedfs/unl-data/daviscupsout)
# For mock version, just use local files
if [ -z "$WOOF_URL" ]; then
    echo "ERROR: -W option required"
    exit 1
fi

# Mock data file path
MOCK_FILE="${MOCK_DATA_DIR}/mock_data.txt"

# Check if mock data exists
if [ ! -f "$MOCK_FILE" ]; then
    echo "ERROR: Mock data file not found: $MOCK_FILE"
    echo "Please create $MOCK_FILE with sample data"
    exit 1
fi

# Return the mock data
cat "$MOCK_FILE"
